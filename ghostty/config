# ────────────────────────────────────────────────────────────
# Blackturq Ghostty Theme
# Deep black + vibrant turquoise accents
# ────────────────────────────────────────────────────────────

# Font
font-family = JetBrainsMono Nerd Font
font-size = 8

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

# Mouse
mouse-scroll-multiplier = 0.95

# ── Blackturq Color Palette ──
# Background & Foreground
background = #0a0a0a
foreground = #c8dcdc

# Cursor
cursor-color = #75dddd

# Selection
selection-foreground = #0a0a0a
selection-background = #c8dcdc

# Normal colors (ANSI 0-7)
palette = 0=#0a0a0a
palette = 1=#D35F5F
palette = 2=#8FECD5
palette = 3=#A9D1D7
palette = 4=#ADF0E9
palette = 5=#485362
palette = 6=#5a676b
palette = 7=#c4d8e2

# Bright colors (ANSI 8-15)
palette = 8=#322F3B
palette = 9=#D35F5F
palette = 10=#8FECD5
palette = 11=#A9D1D7
palette = 12=#ADF0E9
palette = 13=#485362
palette = 14=#5a676b
palette = 15=#d2d9db
